# Copy this file to .env and fill in real values.
# Both keys below are currently TEMPORARY TEST KEYS shared during the demo phase.
# Replace with your own production keys before relying on this for real work.

# Autoaddress (https://docs.autoaddress.com) — Eircode/address resolution.
# Public "pub_..." key, usable client- or server-side for search/lookup.
AUTOADDRESS_KEY=pub_8fac4965-f336-4556-987c-fe8556edeb75

# Google Maps Geocoding API key (https://console.cloud.google.com).
# Must have "Geocoding API" enabled on its Cloud project (Maps JavaScript API
# is NOT the same product and will not work for server-side calls).
GOOGLE_MAPS_API_KEY=AIzaSyBrxuvsYe_LAACJ-Y_1MDuBt2OFDVVbL6c
